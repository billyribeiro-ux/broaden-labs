# Copy to .env and fill in. Every variable here is declared and validated in
# src/env.ts — an invalid value fails the build (static vars) or startup
# (dynamic vars) with a named error rather than failing silently at runtime.
#
# Placeholders only. Never commit real credentials.

# ── Required ──────────────────────────────────────────────────────────────────

# Local development uses a Homebrew Postgres over plain TCP; production uses
# Neon's *pooled* connection string. TLS is branched off this URL, not off `dev`
# (see src/lib/server/db/index.ts), so localhost needs no sslmode and Neon needs
# sslmode=require.
DATABASE_URL="postgres://localhost:5432/broaden_labs"

# Canonical absolute origin. No trailing slash. This is deliberately the
# production domain even on preview deployments, so preview URLs are never
# canonicalised into search results.
PUBLIC_ORIGIN="http://localhost:5173"

# development | preview | production
PUBLIC_SITE_ENV="development"

PUBLIC_CONTACT_EMAIL="hello@broadenlabs.com"

# ── Optional (absent = the feature stays off, honestly) ───────────────────────

# Absent means no analytics script is loaded at all.
PUBLIC_ANALYTICS_ID=""

# Absent means inquiry notification emails are skipped; the inquiry is still
# persisted and still visible in the database.
RESEND_API_KEY=""

# Absent means errors are logged to stdout only.
SENTRY_DSN=""

# ── Build-time only (read by the Vite content-safety plugin, not by Kit) ──────
#
# Guards against shipping fictional testimonials, metrics and case-study
# outcomes as real client proof. A production build FAILS while demo credential
# content is still enabled. Set to "1" only once every such record has been
# removed or replaced with real, verified content.
# BROADEN_CONTENT_READY=1
