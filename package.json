{
	"name": "broaden-labs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "24.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"og:build": "tsx scripts/build-og.ts",
		"fonts:build": "python3 scripts/build-fonts.py",
		"lighthouse": "lhci autorun --config=./lighthouserc.cjs",
		"lighthouse:collect": "lhci collect --config=./lighthouserc.cjs"
	},
	"dependencies": {
		"@threlte/core": "^8.5.16",
		"drizzle-orm": "^0.45.2",
		"gsap": "^3.15.0",
		"pg": "^8.23.0",
		"phosphor-svelte": "^3.1.0",
		"three": "^0.185.1",
		"valibot": "^1.4.2",
		"web-vitals": "^6.1.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "7.0.0-next.8",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"@types/three": "^0.185.4",
		"@vitest/browser-playwright": "^4.1.11",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.12",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0",
		"vercel": "^59.5.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
